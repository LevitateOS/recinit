#!/bin/busybox sh
# Installed-system initramfs /init, rendered by recinit: finds the root named
# by root= on the command line, fsck's it, mounts it read-only and
# switch_roots to {{SWITCH_ROOT_INIT}}. It knows nothing of the installed
# system's init or libc. Paths and command-line words come from recinit's
# protocol (src/live.rs).
{{IMMUTABLE_INIT_MARKER}}
# recab-kernel-release={{KERNEL_RELEASE}}
#
# With {{IMMUTABLE_OPTION}} (an A/B root) the booted root is locked: its block
# device is set read-only and it is mounted read-only. The other root, named
# by the slot marker, is unlocked: its device is made writable and it is
# mounted read-write at /run/recab/other. The other root never stops the boot.
#
# On any failure it reboots when the command line has {{FAIL_REBOOT_OPTION}},
# and opens an emergency shell otherwise.

export PATH=/bin

msg() {
    if [ -w /dev/kmsg ]; then
        busybox echo "initramfs: $1" > /dev/kmsg
    else
        busybox echo "initramfs: $1"
    fi
}

fail() {
    msg "ERROR: $1"
    if [ -n "$FAIL_REBOOT" ]; then
        msg "{{FAIL_REBOOT_OPTION}} is set: rebooting."
        busybox sync
        exec busybox reboot -f
    fi
    msg "Dropping to an emergency shell. Leaving it stops the machine; reboot to retry."
    exec busybox sh
}

busybox mount -t proc proc /proc || msg "ERROR: mounting /proc failed"
busybox mount -t sysfs sysfs /sys || msg "ERROR: mounting /sys failed"
busybox mount -t devtmpfs devtmpfs /dev || msg "ERROR: mounting /dev failed"
[ -c /dev/console ] && exec </dev/console >/dev/console 2>&1

msg "{{BOOT_BANNER}}"

ROOT=""
ROOT_FSTYPE=""
ROOT_FLAGS=""
FAIL_REBOOT=""
IMMUTABLE=""
for param in $(busybox cat /proc/cmdline); do
    case "$param" in
        root=*) ROOT="${param#root=}" ;;
        rootfstype=*) ROOT_FSTYPE="${param#rootfstype=}" ;;
        rootflags=*) ROOT_FLAGS="${param#rootflags=}" ;;
        {{FAIL_REBOOT_OPTION}}) FAIL_REBOOT=1 ;;
        {{IMMUTABLE_OPTION}}) IMMUTABLE=1 ;;
    esac
done
[ -n "$ROOT" ] || fail "no root= on the kernel command line"
if [ -n "$IMMUTABLE" ]; then
    case ",$ROOT_FLAGS," in
        *,rw,*) fail "a locked A/B root cannot use rootflags=rw" ;;
    esac
fi

[ "$(busybox uname -r)" = "{{KERNEL_RELEASE}}" ] || fail "Kernel and initramfs releases differ"

# Storage drivers and filesystems, dependencies first, stored uncompressed for
# busybox insmod. A module the kernel already has reports EEXIST.
for path in {{BOOT_MODULE_PATHS}}; do
    if ! out="$(busybox insmod "{{MODULES_DIR}}/{{KERNEL_RELEASE}}/$path" 2>&1)"; then
        case "$out" in
            *exists*) ;;
            *) msg "WARNING: loading ${path##*/} failed: $out" ;;
        esac
    fi
done

# The identity must be unique; a cloned GPT must not redirect a root/state
# operation onto another disk with the same tag.
find_device() {
    MATCHED_DEV="$(/usr/sbin/blkid -c /dev/null -t "$1" -o device)"
    [ -n "$MATCHED_DEV" ] || return 1
    [ "$(busybox printf '%s\n' "$MATCHED_DEV" | busybox wc -l)" -eq 1 ] || fail "Partition identity is ambiguous"
    return 0
}

# root=PARTUUID=/UUID=/LABEL= name a device by a tag (util-linux blkid reads
# all three); the drivers probe asynchronously, so wait for it until the
# deadline. root=/dev/... is used as given.
case "$ROOT" in
    PARTUUID=*|UUID=*|LABEL=*)
        msg "Searching for the root device $ROOT..."
        DEV=""
        waited=0
        while :; do
            DEV=""
            if find_device "$ROOT"; then DEV="$MATCHED_DEV"; fi
            [ -n "$DEV" ] && break
            if [ "$waited" -ge {{MEDIA_DEADLINE_SECS}} ]; then
                msg "Block devices: $(/usr/sbin/blkid -c /dev/null | busybox tr '\n' ';')"
                fail "No device matches root=$ROOT after {{MEDIA_DEADLINE_SECS}}s"
            fi
            busybox sleep 1
            waited=$((waited + 1))
        done
        ;;
    /dev/*)
        DEV="$ROOT"
        waited=0
        while [ ! -b "$DEV" ]; do
            [ "$waited" -ge {{MEDIA_DEADLINE_SECS}} ] && fail "$DEV does not appear after {{MEDIA_DEADLINE_SECS}}s"
            busybox sleep 1
            waited=$((waited + 1))
        done
        ;;
    *) fail "unsupported root=$ROOT (PARTUUID=, UUID=, LABEL= or /dev/...)" ;;
esac
msg "Root device: $DEV"

[ -n "$ROOT_FSTYPE" ] || ROOT_FSTYPE="$(/usr/sbin/blkid -c /dev/null -o value -s TYPE "$DEV")"
if [ -n "$IMMUTABLE" ]; then
    busybox blockdev --setrw "$DEV" || fail "Enabling unmounted root filesystem checks failed"
fi
case "$ROOT_FSTYPE" in
    ext2|ext3|ext4)
        # Preen: exit 0 = clean, 1 = errors fixed, 2 = fixed and a reboot is
        # advised (the root is not mounted yet, so continuing is safe).
        /usr/sbin/e2fsck -p "$DEV"
        rc=$?
        [ "$rc" -le 3 ] || fail "fsck of $DEV failed (e2fsck exit $rc); the filesystem needs a manual repair"
        ;;
    "") fail "cannot tell the filesystem type of $DEV" ;;
    *) msg "No fsck for $ROOT_FSTYPE; mounting $DEV unchecked." ;;
esac

# A read-only block device also keeps the installed init's remount service
# (or an accidental second mount) from making the booted root writable.
if [ -n "$IMMUTABLE" ]; then
    busybox blockdev --setro "$DEV" || fail "Locking the booted root device failed"
fi
busybox mount -t "$ROOT_FSTYPE" -o "ro${ROOT_FLAGS:+,$ROOT_FLAGS}" "$DEV" {{NEWROOT}} \
    || fail "Mounting $DEV ($ROOT_FSTYPE) at {{NEWROOT}} failed"

if [ -n "$IMMUTABLE" ]; then
    # The slot marker belongs to this root, never to shared state: its slot,
    # the shared /var partition and the other root.
    IFS=' ' read -r SLOT STATE OTHER EXTRA < {{NEWROOT}}/{{IMMUTABLE_CONFIG}} \
        || fail "The A/B root has no slot marker"
    case "$SLOT" in A|B) ;; *) fail "Invalid slot in the slot marker" ;; esac
    case "$STATE" in PARTUUID=*[!a-fA-F0-9-]*|PARTUUID=|"") fail "Invalid /var partition" ;; PARTUUID=*) ;; *) fail "Invalid /var partition" ;; esac
    [ -z "$EXTRA" ] || fail "Invalid slot marker"
    STATE_DEV=""
    waited=0
    while :; do
        STATE_DEV=""
        if find_device "$STATE"; then STATE_DEV="$MATCHED_DEV"; fi
        [ -n "$STATE_DEV" ] && break
        [ "$waited" -ge {{MEDIA_DEADLINE_SECS}} ] && fail "The /var partition $STATE did not appear"
        busybox sleep 1
        waited=$((waited + 1))
    done
    [ "$(busybox readlink -f "$STATE_DEV")" != "$(busybox readlink -f "$DEV")" ] \
        || fail "The locked root and the writable /var are the same partition"
    [ "$(/usr/sbin/blkid -c /dev/null -o value -s TYPE "$STATE_DEV")" = ext4 ] \
        || fail "The /var partition is not ext4"
    /usr/sbin/e2fsck -p "$STATE_DEV"
    [ "$?" -le 3 ] || fail "The /var partition needs a manual filesystem repair"
    busybox mount -t ext4 -o rw "$STATE_DEV" {{NEWROOT}}/var || fail "Mounting the writable /var failed"

    # User data is shared, including root's home. Publish its first copy only
    # after it is complete, so a power loss retries rather than losing files.
    if [ ! -d {{NEWROOT}}/var/roothome ]; then
        busybox rm -rf {{NEWROOT}}/var/.recab-roothome || fail "Clearing an interrupted root-home copy failed"
        busybox cp -a {{NEWROOT}}/root {{NEWROOT}}/var/.recab-roothome || fail "Preserving root's home failed"
        busybox mv {{NEWROOT}}/var/.recab-roothome {{NEWROOT}}/var/roothome || fail "Publishing root's home failed"
    fi
    busybox mkdir -p {{NEWROOT}}/var/home || fail "Preparing shared homes failed"
    if [ ! -L {{NEWROOT}}/home ]; then
        busybox mount --bind {{NEWROOT}}/var/home {{NEWROOT}}/home || fail "Mounting shared homes failed"
    fi
    busybox mount --bind {{NEWROOT}}/var/roothome {{NEWROOT}}/root || fail "Mounting root's home failed"
    busybox mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs {{NEWROOT}}/run || fail "Mounting /run failed"
    busybox mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs {{NEWROOT}}/tmp || fail "Mounting /tmp failed"
    msg "Root $SLOT is locked (read-only); user data uses the writable /var."

    # The other root is unlocked: writable, mounted read-write. Nothing about
    # it stops the boot; recab copy can recreate it from the booted root.
    OTHER_DEV=""
    case "$OTHER" in
        PARTUUID=*[!a-fA-F0-9-]*|PARTUUID=|"") msg "WARNING: the slot marker names no valid other root" ;;
        PARTUUID=*)
            # Not find_device: an ambiguous other root is skipped, not fatal.
            OTHER_DEV="$(/usr/sbin/blkid -c /dev/null -t "$OTHER" -o device)"
            if [ "$(busybox printf '%s\n' "$OTHER_DEV" | busybox wc -l)" -ne 1 ]; then
                [ -n "$OTHER_DEV" ] && msg "WARNING: more than one partition is $OTHER; not mounting the other root"
                OTHER_DEV=""
            fi
            ;;
        *) msg "WARNING: the slot marker names no valid other root" ;;
    esac
    if [ -n "$OTHER_DEV" ] && [ "$(busybox readlink -f "$OTHER_DEV")" = "$(busybox readlink -f "$DEV")" ]; then
        msg "WARNING: the other root is the booted root; not mounting it"
        OTHER_DEV=""
    fi
    if [ -n "$OTHER_DEV" ]; then
        busybox blockdev --setrw "$OTHER_DEV" || msg "WARNING: making the other root $OTHER_DEV writable failed"
        # Bounded: a failing disk must not hold up the boot (timeout exits 124).
        busybox timeout -k 5 {{OTHER_FSCK_SECS}} /usr/sbin/e2fsck -p "$OTHER_DEV"
        rc=$?
        if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
            msg "WARNING: checking the other root $OTHER_DEV took over {{OTHER_FSCK_SECS}}s; not mounting it"
        elif [ "$rc" -gt 3 ]; then
            msg "WARNING: the other root $OTHER_DEV needs a filesystem repair (e2fsck exit $rc); not mounting it"
        elif busybox mkdir -p {{NEWROOT}}/run/recab/other \
            && busybox mount -t ext4 -o rw,nosuid,nodev "$OTHER_DEV" {{NEWROOT}}/run/recab/other; then
            msg "The other root $OTHER_DEV is unlocked at /run/recab/other."
        else
            msg "WARNING: mounting the other root $OTHER_DEV failed"
        fi
    elif [ -n "$OTHER" ]; then
        msg "WARNING: the other root $OTHER was not found; not mounting it"
    fi
fi

# The init must resolve (a dangling link fails here, not in switch_root).
if ! busybox chroot {{NEWROOT}} /bin/sh -c 'test -x {{SWITCH_ROOT_INIT}}'; then
    fail "{{SWITCH_ROOT_INIT}} in the root filesystem does not resolve to an executable"
fi

busybox mount --move /dev {{NEWROOT}}/dev || fail "Moving /dev into the root failed"
busybox mount --move /proc {{NEWROOT}}/proc || fail "Moving /proc into the root failed"
busybox mount --move /sys {{NEWROOT}}/sys || fail "Moving /sys into the root failed"

msg "Switching root..."
exec busybox switch_root {{NEWROOT}} {{SWITCH_ROOT_INIT}}
