#!/bin/busybox sh
# Live initramfs /init, rendered by recinit: mounts the EROFS rootfs under an
# overlay, then switch_roots into the live system. Every path, command-line
# word and filesystem type comes from recinit's live protocol (src/live.rs).
#
# The kernel must have EROFS built in (CONFIG_EROFS_FS=y); loop and overlay
# may be built in or among the boot modules recinit installs.
#
# Boot flow:
# 1. Mount /proc, /sys, /dev. Messages go to the kernel log (every console);
#    the emergency shell runs on /dev/console, the last console= named.
# 2. insmod the boot modules.
# 3. Find the boot medium by its label (root=LABEL=), waiting for it to
#    appear until a deadline.
# 4. Mount the rootfs and the optional live-overlay payload (EROFS files on
#    the medium).
# 5. Mount the overlay: tmpfs upper over live-overlay over rootfs.
# 6. Import the optional boot injection payload (fw_cfg or a medium with the
#    injection label).
# 7. Move /dev, /proc, /sys and the boot medium into the new root and
#    switch_root to {{SWITCH_ROOT_INIT}}.

export PATH=/bin

# Messages go to the kernel log, which prints them on every console the
# command line names (screen and serial alike).
msg() {
    if [ -w /dev/kmsg ]; then
        busybox echo "initramfs: $1" > /dev/kmsg
    else
        busybox echo "initramfs: $1"
    fi
}

# A shell on the console; leaving it panics the kernel (it is PID 1).
emergency_shell() {
    msg "ERROR: $1"
    msg "Dropping to an emergency shell. Leaving it stops the machine; reboot to retry."
    exec busybox sh
}

busybox mount -t proc proc /proc || msg "ERROR: mounting /proc failed"
busybox mount -t sysfs sysfs /sys || msg "ERROR: mounting /sys failed"
busybox mount -t devtmpfs devtmpfs /dev || msg "ERROR: mounting /dev failed"
# The archive has no device nodes, so the kernel could not open a console
# for /init; devtmpfs has /dev/console, the console the command line names.
[ -c /dev/console ] && exec </dev/console >/dev/console 2>&1

msg "{{BOOT_BANNER}}"

# Load kernel modules for boot, dependencies first. recinit resolved them
# against this kernel and stored them uncompressed for busybox insmod. A
# module the kernel already has (built in or loaded) reports EEXIST.
for path in {{BOOT_MODULE_PATHS}}; do
    if ! out="$(busybox insmod "/lib/modules/{{KERNEL_RELEASE}}/$path" 2>&1)"; then
        case "$out" in
            *exists*) ;;
            *) msg "WARNING: loading ${path##*/} failed: $out" ;;
        esac
    fi
done

CMDLINE=$(busybox cat /proc/cmdline)
ROOT_LABEL="{{ISO_LABEL}}"
EMERGENCY=""
BOOT_INJECTION_REQUIRED=""
for param in $CMDLINE; do
    case "$param" in
        root=LABEL=*) ROOT_LABEL="${param#root=LABEL=}" ;;
        {{CMDLINE_EMERGENCY}}) EMERGENCY=1 ;;
        {{CMDLINE_BOOT_INJECTION_REQUIRED}}) BOOT_INJECTION_REQUIRED=1 ;;
    esac
done

# The boot medium is the device with the medium's label. Storage drivers
# probe asynchronously (USB, NVMe), so wait for it until the deadline.
msg "Searching for the boot medium labelled '$ROOT_LABEL'..."
BOOT_DEV=""
waited=0
while :; do
    BOOT_DEV="$(busybox findfs "LABEL=$ROOT_LABEL" 2>/dev/null)"
    [ -n "$BOOT_DEV" ] && break
    if [ "$waited" -ge {{MEDIA_DEADLINE_SECS}} ]; then
        msg "No device has the label '$ROOT_LABEL' after {{MEDIA_DEADLINE_SECS}}s."
        msg "Kernel cmdline: $CMDLINE"
        msg "Block devices: $(busybox blkid | busybox tr '\n' ';')"
        emergency_shell "Boot medium not found"
    fi
    busybox sleep 1
    waited=$((waited + 1))
done
if ! busybox mount -o ro "$BOOT_DEV" {{MEDIA_MOUNT}}; then
    emergency_shell "Mounting the boot medium $BOOT_DEV at {{MEDIA_MOUNT}} failed"
fi
msg "Boot medium: $BOOT_DEV"

if [ -n "$EMERGENCY" ]; then
    msg "Shell requested on the kernel command line ({{CMDLINE_EMERGENCY}}); the boot medium is at {{MEDIA_MOUNT}}."
    msg "Type 'exit' to continue booting."
    busybox sh
fi

# An EROFS payload file on the medium (busybox mount attaches a loop device
# for a file).
mount_payload() {
    busybox mount -t erofs -o ro "$1" "$2" || emergency_shell "Mounting the $3 payload $1 (EROFS) failed"
}

ROOTFS_SRC="{{MEDIA_MOUNT}}{{ROOTFS_PATH}}"
[ -f "$ROOTFS_SRC" ] || emergency_shell "{{ROOTFS_MISSING_MESSAGE}} (no {{ROOTFS_PATH}} on $BOOT_DEV)"
msg "Mounting the rootfs payload $ROOTFS_SRC"
mount_payload "$ROOTFS_SRC" {{ROOTFS_MOUNT}} rootfs

# OverlayFS lowerdir lists the higher layer first: the live overlay payload
# (when the medium has one) over the rootfs. Writes go to a tmpfs.
LOWERDIR="{{ROOTFS_MOUNT}}"
OVERLAY_SRC=""
if [ -f "{{MEDIA_MOUNT}}{{LIVE_OVERLAY_IMAGE_PATH}}" ]; then
    OVERLAY_SRC="{{MEDIA_MOUNT}}{{LIVE_OVERLAY_IMAGE_PATH}}"
    msg "Mounting the live overlay payload $OVERLAY_SRC"
    mount_payload "$OVERLAY_SRC" {{LIVE_OVERLAY_MOUNT}} "live overlay"
    LOWERDIR="{{LIVE_LOWERDIR}}"
fi

busybox mount -t tmpfs -o size=50% tmpfs {{OVERLAY_DIR}} || emergency_shell "Mounting the tmpfs at {{OVERLAY_DIR}} failed"
busybox mkdir {{OVERLAY_DIR}}/upper {{OVERLAY_DIR}}/work || emergency_shell "Creating the overlay's directories failed"
if ! busybox mount -t overlay overlay \
    -o "lowerdir=$LOWERDIR,upperdir={{OVERLAY_DIR}}/upper,workdir={{OVERLAY_DIR}}/work" \
    {{NEWROOT}}; then
    emergency_shell "Mounting the overlay ($LOWERDIR) at {{NEWROOT}} failed"
fi
busybox touch "{{NEWROOT}}{{BOOT_MARKER}}" || emergency_shell "Creating {{BOOT_MARKER}} failed"

busybox mkdir -p "{{NEWROOT}}/run" "{{NEWROOT}}/tmp" || emergency_shell "Creating /run and /tmp in the live root failed"
busybox mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "{{NEWROOT}}/run" || emergency_shell "Mounting /run in the live root failed"
busybox mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "{{NEWROOT}}/tmp" || emergency_shell "Mounting /tmp in the live root failed"

# Stable payload handles for installers, created on the live /run so no later
# mount hides them. They point where the boot medium ends up
# ({{LIVE_MEDIA_DIR}}, moved below).
live_path() {
    busybox echo "{{LIVE_MEDIA_DIR}}${1#{{MEDIA_MOUNT}}}"
}
busybox ln -s "$(live_path "$ROOTFS_SRC")" "{{NEWROOT}}{{ROOTFS_HANDLE}}" || emergency_shell "Creating {{ROOTFS_HANDLE}} failed"
if [ -n "$OVERLAY_SRC" ]; then
    busybox ln -s "$(live_path "$OVERLAY_SRC")" "{{NEWROOT}}{{OVERLAY_HANDLE}}" || emergency_shell "Creating {{OVERLAY_HANDLE}} failed"
fi

# Import the optional host-provided boot injection payload: the QEMU fw_cfg
# entry {{BOOT_INJECTION_FW_CFG}}, else a read-only medium labelled
# {{BOOT_INJECTION_ISO_LABEL}} holding /{{BOOT_INJECTION_FILE}}. This runs before
# /dev moves into the new root.
busybox mkdir -p "{{NEWROOT}}{{BOOT_INJECTION_DIR}}" || emergency_shell "Creating {{BOOT_INJECTION_DIR}} failed"
BOOT_INJECTION_PAYLOAD="{{NEWROOT}}{{BOOT_INJECTION_ENV}}"
BOOT_INJECTION_RAW="/sys/firmware/qemu_fw_cfg/by_name/{{BOOT_INJECTION_FW_CFG}}/raw"
import_payload() {
    busybox cat "$1" > "$BOOT_INJECTION_PAYLOAD" || emergency_shell "Importing the boot injection payload from $2 failed"
    busybox chmod 0600 "$BOOT_INJECTION_PAYLOAD" || emergency_shell "Restricting $BOOT_INJECTION_PAYLOAD failed"
    busybox echo "$2" > "{{NEWROOT}}{{BOOT_INJECTION_DIR}}/source" || emergency_shell "Recording the boot injection source failed"
    msg "Imported the boot injection payload from $2"
}
if [ -r "$BOOT_INJECTION_RAW" ]; then
    import_payload "$BOOT_INJECTION_RAW" fw_cfg
else
    INJECT_DEV="$(busybox findfs "LABEL={{BOOT_INJECTION_ISO_LABEL}}" 2>/dev/null)"
    if [ -n "$INJECT_DEV" ]; then
        busybox mount -o ro "$INJECT_DEV" {{BOOT_INJECTION_MEDIA_MOUNT}} || emergency_shell "Mounting the boot injection medium $INJECT_DEV failed"
        [ -r "{{BOOT_INJECTION_MEDIA_MOUNT}}/{{BOOT_INJECTION_FILE}}" ] || emergency_shell "The boot injection medium $INJECT_DEV has no {{BOOT_INJECTION_FILE}}"
        import_payload "{{BOOT_INJECTION_MEDIA_MOUNT}}/{{BOOT_INJECTION_FILE}}" "medium:$INJECT_DEV"
        busybox umount {{BOOT_INJECTION_MEDIA_MOUNT}} || emergency_shell "Unmounting the boot injection medium failed"
    fi
fi

if [ -r "$BOOT_INJECTION_PAYLOAD" ]; then
    # SSH key handoff: the host injects {{SSH_KEY_VAR}} (or {{SSH_KEYS_VAR}},
    # ';'-separated), which becomes root's authorized_keys.
    SSH_KEYS="$(busybox sed -n \
        -e 's/^{{SSH_KEY_VAR}}=//p' \
        -e 's/^{{SSH_KEYS_VAR}}=//p' \
        "$BOOT_INJECTION_PAYLOAD")"
    if [ -n "$SSH_KEYS" ]; then
        SSH_DIR="{{NEWROOT}}{{ROOT_SSH_DIR}}"
        busybox mkdir -p "$SSH_DIR" && busybox chmod 700 "$SSH_DIR" \
            && busybox echo "$SSH_KEYS" | busybox tr ';' '\n' > "$SSH_DIR/authorized_keys" \
            && busybox chmod 600 "$SSH_DIR/authorized_keys" \
            || emergency_shell "Installing the injected SSH keys in {{ROOT_SSH_DIR}} failed"
        msg "Injected SSH authorized key(s) from the boot payload"
    fi
elif [ -n "$BOOT_INJECTION_REQUIRED" ]; then
    emergency_shell "Required boot injection payload missing ({{CMDLINE_BOOT_INJECTION_REQUIRED}})"
fi

busybox mkdir -p "{{NEWROOT}}/dev" "{{NEWROOT}}/proc" "{{NEWROOT}}/sys" "{{NEWROOT}}{{LIVE_MEDIA_DIR}}" \
    || emergency_shell "Creating the live root's mount points failed"
busybox mount --move /dev "{{NEWROOT}}/dev" || emergency_shell "Moving /dev into the live root failed"
busybox mount --move /proc "{{NEWROOT}}/proc" || emergency_shell "Moving /proc into the live root failed"
busybox mount --move /sys "{{NEWROOT}}/sys" || emergency_shell "Moving /sys into the live root failed"
# The boot medium stays mounted at {{LIVE_MEDIA_DIR}} for the installer.
busybox mount --move {{MEDIA_MOUNT}} "{{NEWROOT}}{{LIVE_MEDIA_DIR}}" || emergency_shell "Moving the boot medium into the live root failed"

# The init must resolve (a dangling link fails here, not in switch_root).
if ! busybox chroot {{NEWROOT}} /bin/sh -c 'test -x {{SWITCH_ROOT_INIT}}'; then
    emergency_shell "{{SWITCH_ROOT_INIT}} in the live root does not resolve to an executable"
fi

msg "Switching root to the live system..."
exec busybox switch_root {{NEWROOT}} {{SWITCH_ROOT_INIT}}
